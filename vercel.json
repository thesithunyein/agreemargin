{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/", "destination": "/api/handler" },
    { "source": "/:page(new|workspace|review|manage|privacy|docs|faq|FAQ)", "destination": "/api/handler?__route=:page" },
    { "source": "/:asset(app.css|app.js|mark.svg)", "destination": "/api/handler?__route=:asset" },
    { "source": "/api/requests", "destination": "/api/handler?__route=api/requests" },
    { "source": "/api/requests/:path+", "destination": "/api/handler?__route=api/requests/:path+" }
  ]
}
